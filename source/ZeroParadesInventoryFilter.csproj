<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <AssemblyName>ZeroParadesInventoryFilter</AssemblyName>
    <Version>1.0.0</Version>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="BepInEx.Core"><HintPath>$(ZPGameDir)\BepInEx\core\BepInEx.Core.dll</HintPath></Reference>
    <Reference Include="BepInEx.Unity.IL2CPP"><HintPath>$(ZPGameDir)\BepInEx\core\BepInEx.Unity.IL2CPP.dll</HintPath></Reference>
    <Reference Include="BepInEx.Unity.Common"><HintPath>$(ZPGameDir)\BepInEx\core\BepInEx.Unity.Common.dll</HintPath></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(ZPGameDir)\BepInEx\core\Il2CppInterop.Runtime.dll</HintPath></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(ZPGameDir)\BepInEx\interop\Assembly-CSharp.dll</HintPath></Reference>
    <Reference Include="ZAUM.FELD.C4.Inventory"><HintPath>$(ZPGameDir)\BepInEx\interop\ZAUM.FELD.C4.Inventory.dll</HintPath></Reference>
    <Reference Include="ZAUM.FELD"><HintPath>$(ZPGameDir)\BepInEx\interop\ZAUM.FELD.dll</HintPath></Reference>
    <Reference Include="ZAUM.FELD.C4.Dialogues"><HintPath>$(ZPGameDir)\BepInEx\interop\ZAUM.FELD.C4.Dialogues.dll</HintPath></Reference>
    <Reference Include="Assembly-CSharp-firstpass"><HintPath>$(ZPGameDir)\BepInEx\interop\Assembly-CSharp-firstpass.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ZPGameDir)\BepInEx\interop\UnityEngine.CoreModule.dll</HintPath></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(ZPGameDir)\BepInEx\interop\Unity.TextMeshPro.dll</HintPath></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(ZPGameDir)\BepInEx\interop\UnityEngine.UI.dll</HintPath></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(ZPGameDir)\BepInEx\interop\UnityEngine.InputLegacyModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(ZPGameDir)\BepInEx\interop\UnityEngine.UIModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(ZPGameDir)\BepInEx\interop\UnityEngine.TextRenderingModule.dll</HintPath></Reference>
    <Reference Include="Il2Cppmscorlib"><HintPath>$(ZPGameDir)\BepInEx\interop\Il2Cppmscorlib.dll</HintPath></Reference>
  </ItemGroup>
</Project>
